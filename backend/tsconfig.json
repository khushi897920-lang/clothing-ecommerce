{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": ["../database/node_modules/@prisma/client"],
      "*": ["node_modules/*", "../database/node_modules/*"]
    }
  },
  "include": [
    "**/*.ts",
    "shared/**/*.ts",
    "api-gateway/**/*.ts",
    "auth-service/**/*.ts",
    "user-service/**/*.ts",
    "product-service/**/*.ts",
    "inventory-service/**/*.ts",
    "order-service/**/*.ts",
    "payment-service/**/*.ts",
    "notification-service/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
