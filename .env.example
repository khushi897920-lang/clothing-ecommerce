# Infrastructure Ports & Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce

# Cache & Message Broker
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672

# JWT Secrets
JWT_SECRET=super_secret_jwt_key
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key

# Third Party Integrations
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=cloudinary_placeholder
CLOUDINARY_API_KEY=key_placeholder
CLOUDINARY_API_SECRET=secret_placeholder

# Email SMTP Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=smtp_user_placeholder
SMTP_PASSWORD=smtp_password_placeholder
EMAIL_FROM=noreply@yugen.com

# Microservice URLs (Internal & Gateway)
PORT=8000
AUTH_SERVICE_URL=http://auth-service:8001
USER_SERVICE_URL=http://user-service:8002
PRODUCT_SERVICE_URL=http://product-service:8003
INVENTORY_SERVICE_URL=http://inventory-service:8004
ORDER_SERVICE_URL=http://order-service:8005
PAYMENT_SERVICE_URL=http://payment-service:8006
NOTIFICATION_SERVICE_URL=http://notification-service:8007
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGIN=http://localhost:3000
